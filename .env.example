# =============================================================
# Realis — variables d'environnement (exemple)
# Copier ce fichier en .env et remplir TOUTES les valeurs CHANGE_ME
# Ne jamais committer le fichier .env
# =============================================================

# --- PostgreSQL ---
POSTGRES_DB=realis
POSTGRES_USER=realis_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend Spring Boot ---
DB_URL=jdbc:postgresql://postgres:5432/realis
DB_USER=realis_user
DB_PASSWORD=CHANGE_ME

# Secret JWT (minimum 32 caractères, aléatoire)
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG

# Chemin de stockage des captures chiffrées (volume Docker)
STORAGE_PATH=/data/captures

# Clé AES-256 pour le chiffrement at rest (32 octets en Base64)
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTES

# --- TSA (Time Stamp Authority) ---
TSA_PROVIDER=freetsa
TSA_URL=https://freetsa.org/tsr
TSA_CERT_PATH=/app/tsa-certs/freetsa-ca.crt

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080

# URL publique du frontend (utilisée par le backend pour construire des liens
# absolus dans les certificats PDF, ex. https://realis.app en production)
FRONTEND_URL=http://localhost:3000
